# Copy to .env and fill in. Any missing key switches that integration to MOCK mode.

# Claude (Anthropic API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# PayPal Sandbox app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Channel3 product search (trychannel3.com/developers, promo code PAYPAL-HACKATHON-2026)
CHANNEL3_API_KEY=

# Server
PORT=3001
# Public URL PayPal redirects back to after approval (your hosted demo URL in production)
PUBLIC_URL=http://localhost:3001
# Where the browser lands after PayPal returns (set to http://localhost:5173 when using the Vite dev server)
APP_URL=http://localhost:3001
# Flat shipping per order in USD
SHIPPING_FLAT_USD=0
# Set to 1 to force every integration into MOCK mode
FORCE_MOCK=0

# PayPal Sandbox test buyer shown to judges in the checkout dialog (sandbox accounts hold fake money)
SANDBOX_BUYER_EMAIL=
SANDBOX_BUYER_PASSWORD=
